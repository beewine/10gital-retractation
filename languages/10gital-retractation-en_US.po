#: includes/Frontend/OrderLookup.php:68
msgid "Merci d'indiquer un numéro de commande et une adresse e-mail valides."
msgstr "Please provide a valid order number and email address."

#: includes/Frontend/OrderLookup.php:75
msgid "Trop de tentatives. Merci de réessayer dans une quinzaine de minutes."
msgstr "Too many attempts. Please try again in about fifteen minutes."

#: includes/Frontend/OrderLookup.php:218
